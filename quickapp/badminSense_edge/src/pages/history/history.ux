<template><scroll class="page" scroll-y="true"><div class="container">
  <div class="header"><image src="/common/images/icon-back.png" class="back" onclick="goBack"/><text class="title">训练历史</text></div>
  <div if="{{historyList.length === 0}}" class="empty"><text class="empty-title">还没有训练记录</text><text class="muted">完成一次运动后会显示在这里</text></div>
  <list if="{{historyList.length > 0}}" class="list"><list-item type="record" for="{{historyList}}" tid="id" class="item" onclick="openRecord($item)"><div class="content"><div class="left"><text class="date">{{formatDate($item.startTime)}}</text><text class="duration">{{formatDuration($item.activeDuration)}}</text></div><div class="right"><text class="hits">{{$item.hits.total}} 次击球</text><text class="calories">{{$item.calories.value}} kcal</text></div></div></list-item></list>
</div></scroll></template>
<style>
.page{width:100%;height:100%;background-color:#0b1020}.container{width:100%;padding:42px 38px 60px;flex-direction:column}.header{flex-direction:row;align-items:center;margin-bottom:20px}.back{width:32px;height:32px;margin-right:14px}.title{color:#fff;font-size:32px;font-weight:bold}.empty{align-items:center;flex-direction:column;margin-top:110px}.empty-title{color:#fff;font-size:24px}.muted,.date,.calories{color:#8fa1bd;font-size:18px;margin-top:8px}.list{width:100%;flex-direction:column}.item{margin-bottom:12px}.content{width:100%;padding:18px 20px;background-color:#151d33;border-radius:18px;flex-direction:row}.left{flex:1;flex-direction:column}.right{align-items:flex-end;flex-direction:column}.duration{color:#fff;font-size:28px;font-weight:bold;margin-top:5px}.hits{color:#30e18b;font-size:20px;font-weight:bold}
</style>
<script>
import router from '@system.router'
import dataStore from '../../common/data-store'
export default {private:{historyList:[]},onShow(){dataStore.loadHistory(records=>{this.historyList=records.filter(item=>item&&item.id)})},formatDate(timestamp){const date=new Date(timestamp);return `${date.getMonth()+1}月${date.getDate()}日`},formatDuration(seconds){const value=Number(seconds)||0;return `${Math.floor(value/60)}:${(value%60).toString().padStart(2,'0')}`},openRecord(item){router.push({uri:'/pages/workout/summary',params:{workoutData:JSON.stringify(item),readOnly:true}})},goBack(){router.back()}}
</script>
